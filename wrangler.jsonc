{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mf-web",
  "compatibility_date": "2026-03-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  },
  "routes": [
    {
      "pattern": "mellifluous.lasteinsa.my.id",
      "custom_domain": true
    }
  ]
}
